#!/bin/bash
# ==============================================================================
# MQ Intake Claims - Environment Configuration
# ==============================================================================
#
# Copy this file to <deploy_path>/env.sh and fill in values.
# chmod 600 env.sh - it contains credentials.
#
# This file is sourced by intake.sh before starting the application.
# ==============================================================================

# ==============================================================================
# REQUIRED - Application will not start without these
# ==============================================================================

# Java Runtime (must be Java 11+)
export JAVA_HOME=/path/to/jdk11

# MQ Connection
export IBM_MQ_QUEUEMANAGER=YOUR_QUEUE_MANAGER
export IBM_MQ_CHANNEL=YOUR_SVRCONN_CHANNEL
export IBM_MQ_CONNNAME=mqserver.company.com(1414)
export IBM_MQ_USER=svc_mq_claims
export IBM_MQ_PASSWORD=CHANGEME

# MQ Queues
export MQ_SOURCE_QUEUE=DMIH.CLAIMS.INBOUND
export MQ_BACKOUT_QUEUE=DMIH.CLAIMS.INBOUND.BO
# Note: Claims does not use a tracker queue

# HDFS Base Path
export HDFS_BASE_PATH=/raw/claims/dmih

# ==============================================================================
# OPTIONAL - Defaults are usually fine
# ==============================================================================

# Server port for health/metrics endpoints (default: 8080)
export SERVER_PORT=8099

# JVM settings (default: -Xmx4g)
export JAVA_OPTS="-Xmx4g -XX:+UseG1GC"

# Listener threads per binding (default: 4)
# export INTAKE_BINDINGS_0_LISTENER_THREADS=4

# Batch settings
# export INTAKE_BINDINGS_0_BATCH_SIZE=8000
# export INTAKE_BINDINGS_0_BATCH_BYTES=134217728
# export INTAKE_BINDINGS_0_BATCH_INTERVAL_MS=0

# ==============================================================================
# KERBEROS - If not using default keytab location
# ==============================================================================

# export KRB5_KEYTAB=/path/to/service.keytab
# export KRB5_PRINCIPAL=svc_hdfs@REALM.COM

# ==============================================================================
# PRODUCTION MODE - Uncomment to enable strict validation
# ==============================================================================

# Blocks startup if required config is missing
# export MQ_INTAKE_PRODUCTION=true

# ==============================================================================
# CLAIMS IDENTITY FIELD - Required in production mode
# ==============================================================================

# Uncomment when identity field is decided
# export CLAIMS_IDENTITY_FIELD=CLM_ID

# ==============================================================================
# LOGGING - Override log directory if needed
# ==============================================================================

# export LOG_PATH=/custom/log/path
