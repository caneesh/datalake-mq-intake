# Environment for the MQ -> HDFS intake service.
#
# Deployed once as <base>/env.sh and NEVER overwritten by a later deploy.
# Holds credentials: keep it chmod 600, and do not copy it into the repository.
#
# Every value below is read by the application exactly as the shipped
# application.yml declares it, so nothing here needs a matching code change.

# ---------------------------------------------------------------- IBM MQ ----
export MQ_HOST=changeme.example.net
export MQ_PORT=1414
export MQ_QUEUE_MANAGER=CHANGEME
export MQ_CHANNEL=CHANGEME.SVRCONN

# Queue names. The source, tracker and backout queues must all be defined on
# the queue manager above: the tracker and backout producers are created from
# the listener's own transacted session and cannot reach a sibling QM.
export MQ_SOURCE_QUEUE=CHANGEME.IN
export MQ_TRACKER_QUEUE=CHANGEME.TRACKER     # RMS only; unused by claims
export MQ_BACKOUT_QUEUE=CHANGEME.BACKOUT

# Credentials are referenced, not embedded. 'env:USER_VAR,PASS_VAR' reads the
# two variables below; the application never logs either.
export MQ_CREDENTIAL_REF="env:MQ_USER,MQ_PASSWORD"
export MQ_USER=changeme
export MQ_PASSWORD=changeme

# ------------------------------------------------------------------ HDFS ----
# REQUIRED for a real cluster. Without it the service resolves fs.defaultFS to
# file:/// and writes to this server's local disk -- successfully and silently.
# Production mode refuses to start in that state.
#
# On a host that also runs another Hadoop client, point this at the TARGET
# cluster's conf directory, not at whatever the host's default happens to be.
export HDFS_CONFIG_RESOURCES=/path/to/target-cluster/conf

# What fs.defaultFS must contain after those files load -- normally the
# cluster's dfs.nameservices value. This is the one check that catches being
# pointed at the wrong conf directory: without it a wrong path still connects,
# authenticates, writes and reports healthy, against the wrong cluster.
export HDFS_EXPECTED_NAMESERVICE=changeme

export HDFS_BASE_PATH=/data/raw/changeme
export HDFS_AUDIT_BASE_PATH=/data/audit

# Hadoop property overrides go in config/application.yml under
# intake.hdfs.properties, or as -D system properties here. The one this kind
# of deployment usually needs:
#
#   dfs.client.use.datanode.hostname=true
#
# The NameNode hands the client a list of DataNodes to write to. When the
# client sits outside the cluster's network segment it can often resolve the
# DataNode hostnames but cannot route to the IP addresses returned, so the
# NameNode connects and every write still fails. This makes the client use
# hostnames. Uncomment if that describes this host:
#
# export JAVA_OPTS="$JAVA_OPTS -Dintake.hdfs.properties.dfs.client.use.datanode.hostname=true"

# -------------------------------------------------------------- Kerberos ----
export KERBEROS_ENABLED=false
# export KERBEROS_PRINCIPAL=svc-intake@REALM
# export KERBEROS_KEYTAB_PATH=/etc/security/keytabs/svc-intake.keytab

# ------------------------------------------------------------ Behaviour -----
# Arms every safety gate: dev-default connection values, placeholder
# serializers and incomplete tracker contracts all refuse to start. Leave this
# on in any environment that stands in for production.
export MQ_INTAKE_PRODUCTION=true

# Heap. The batch budget is listener-threads x batch.bytes (RMS: 4 x 128 MB),
# and payload copies during normalisation and serialisation multiply that;
# 4g is the recommended floor. Startup fails if the configured batch budget
# exceeds 50% of max heap.
export JAVA_OPTS="-Xmx4g"

# Leave unset so the instance id derives as hostname-pid. Two JVMs on one host
# sharing an id would share a _tmp tree and could collide on output filenames.
# export INTAKE_INSTANCE_ID=

# How long 'stop' waits for the drain before giving up and telling you.
export STOP_TIMEOUT_SECONDS=90
