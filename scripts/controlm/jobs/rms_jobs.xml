<?xml version="1.0" encoding="UTF-8"?>
<!--
    Control-M Job Definitions for MQ Intake RMS

    Import this file into Control-M to create the job definitions.
    Update the %%VARIABLES to match your environment before import.

    Folder: DATALAKE/MQ_INTAKE/RMS
-->
<DEFTABLE>
    <FOLDER
        DATACENTER="DEFAULT"
        FOLDER_NAME="DATALAKE/MQ_INTAKE/RMS"
        FOLDER_ORDER_METHOD="SYSTEM">

        <!-- ================================================================ -->
        <!-- OPERATIONS JOBS                                                   -->
        <!-- ================================================================ -->

        <JOB
            JOBNAME="RMS_PREFLIGHT"
            DESCRIPTION="Validate MQ and HDFS connectivity for RMS"
            NODEID="%%NODEID"
            CMDLINE="%%APP_BASE_RMS/current/intake.sh preflight"
            TASKTYPE="Job"
            RUN_AS="%%RUN_AS"
            MAXRERUN="0"
            CONFIRM="N">

            <OUTCOND NAME="RMS_PREFLIGHT-OK" ODATE="ODAT" SIGN="+"/>

            <ON STMT="*" CODE="NOTOK">
                <DOSHOUT
                    DEST="%%EMAIL_OPS"
                    MESSAGE="RMS Preflight FAILED on %%NODEID - check MQ/HDFS connectivity"
                    URGENCY="U"/>
            </ON>
        </JOB>

        <JOB
            JOBNAME="RMS_START"
            DESCRIPTION="Start RMS MQ Intake service"
            NODEID="%%NODEID"
            CMDLINE="%%APP_BASE_RMS/current/intake.sh start"
            TASKTYPE="Job"
            RUN_AS="%%RUN_AS"
            MAXRERUN="1">

            <INCOND NAME="RMS_PREFLIGHT-OK" ODATE="ODAT" AND_OR="A"/>
            <OUTCOND NAME="RMS_START-OK" ODATE="ODAT" SIGN="+"/>

            <ON STMT="*" CODE="NOTOK">
                <DOSHOUT
                    DEST="%%EMAIL_OPS"
                    MESSAGE="RMS Start FAILED on %%NODEID"
                    URGENCY="U"/>
                <DOCMD CMD="%%CTM_SCRIPTS/create_incident.sh 'RMS_START' 'FAILED' '%%$ORDERID' 'high'"/>
            </ON>
        </JOB>

        <JOB
            JOBNAME="RMS_STOP"
            DESCRIPTION="Stop RMS MQ Intake service (graceful drain)"
            NODEID="%%NODEID"
            CMDLINE="%%APP_BASE_RMS/current/intake.sh stop"
            TASKTYPE="Job"
            RUN_AS="%%RUN_AS"
            MAXRERUN="0">
        </JOB>

        <JOB
            JOBNAME="RMS_RESTART"
            DESCRIPTION="Restart RMS MQ Intake service"
            NODEID="%%NODEID"
            CMDLINE="%%APP_BASE_RMS/current/intake.sh stop; sleep 10; %%APP_BASE_RMS/current/intake.sh start"
            TASKTYPE="Job"
            RUN_AS="%%RUN_AS"
            MAXRERUN="1">

            <ON STMT="*" CODE="NOTOK">
                <DOSHOUT
                    DEST="%%EMAIL_OPS"
                    MESSAGE="RMS Restart FAILED on %%NODEID - manual intervention required"
                    URGENCY="V"/>
                <DOCMD CMD="%%CTM_SCRIPTS/page_oncall.sh 'RMS_RESTART' 'RMS restart failed on %%NODEID' 'critical'"/>
            </ON>

            <ON STMT="*" CODE="OK">
                <DOCMD CMD="%%CTM_SCRIPTS/resolve_incident.sh 'RMS_HEALTH_CHECK'"/>
            </ON>
        </JOB>

        <!-- ================================================================ -->
        <!-- MONITORING JOBS                                                   -->
        <!-- ================================================================ -->

        <JOB
            JOBNAME="RMS_HEALTH_CHECK"
            DESCRIPTION="Check RMS service health via actuator"
            NODEID="%%NODEID"
            CMDLINE="%%CTM_SCRIPTS/health_check.sh rms %%SERVER_PORT_RMS"
            TASKTYPE="Job"
            RUN_AS="%%RUN_AS"
            CYCLIC="Y"
            INTERVAL="00:05"
            MAXRERUN="0">

            <!-- First failure: Warning + attempt restart -->
            <ON STMT="*" CODE="NOTOK" TIMES="1">
                <DOSHOUT
                    DEST="%%EMAIL_OPS"
                    MESSAGE="RMS Health Check failed (attempt 1) - will attempt restart"
                    URGENCY="R"/>
                <DOFORCEJOB FOLDER="DATALAKE/MQ_INTAKE/RMS" JOBNAME="RMS_RESTART"/>
            </ON>

            <!-- Second failure: Create incident -->
            <ON STMT="*" CODE="NOTOK" TIMES="2">
                <DOSHOUT
                    DEST="%%EMAIL_OPS"
                    MESSAGE="RMS Health Check failed (attempt 2) - incident created"
                    URGENCY="U"/>
                <DOCMD CMD="%%CTM_SCRIPTS/create_incident.sh 'RMS_HEALTH_CHECK' 'FAILED' '%%$ORDERID' 'high'"/>
            </ON>

            <!-- Third failure: Page on-call -->
            <ON STMT="*" CODE="NOTOK" TIMES="3">
                <DOSHOUT
                    DEST="%%EMAIL_MGMT"
                    MESSAGE="CRITICAL: RMS service down after multiple restart attempts"
                    URGENCY="V"/>
                <DOCMD CMD="%%CTM_SCRIPTS/page_oncall.sh 'RMS_HEALTH_CHECK' 'CRITICAL: RMS intake down after 3 failures' 'critical'"/>
            </ON>

            <!-- Success: Resolve any open incidents -->
            <ON STMT="*" CODE="OK">
                <DOCMD CMD="%%CTM_SCRIPTS/resolve_incident.sh 'RMS_HEALTH_CHECK'"/>
            </ON>
        </JOB>

        <JOB
            JOBNAME="RMS_QUEUE_DEPTH"
            DESCRIPTION="Monitor RMS source queue depth"
            NODEID="%%NODEID"
            CMDLINE="%%CTM_SCRIPTS/queue_depth_check.sh rms %%SERVER_PORT_RMS %%QUEUE_DEPTH_WARN %%QUEUE_DEPTH_CRIT"
            TASKTYPE="Job"
            RUN_AS="%%RUN_AS"
            CYCLIC="Y"
            INTERVAL="00:05"
            MAXRERUN="0">

            <ON STMT="*" CODE="COMPSTAT" SIGN="GT" VAL="0">
                <DOSHOUT
                    DEST="%%EMAIL_OPS"
                    MESSAGE="RMS Queue Depth Alert - check consumer throughput"
                    URGENCY="R"/>
            </ON>
        </JOB>

        <JOB
            JOBNAME="RMS_BACKOUT_ALERT"
            DESCRIPTION="Alert on RMS backout queue messages"
            NODEID="%%NODEID"
            CMDLINE="%%CTM_SCRIPTS/backout_alert.sh rms %%SERVER_PORT_RMS"
            TASKTYPE="Job"
            RUN_AS="%%RUN_AS"
            CYCLIC="Y"
            INTERVAL="00:15"
            MAXRERUN="0">

            <ON STMT="*" CODE="NOTOK">
                <DOSHOUT
                    DEST="%%EMAIL_OPS"
                    MESSAGE="ALERT: Poison messages in RMS backout queue"
                    URGENCY="U"/>
                <DOCMD CMD="%%CTM_SCRIPTS/page_oncall.sh 'RMS_BACKOUT_ALERT' 'Poison messages in RMS backout queue' 'error'"/>
                <DOCMD CMD="%%CTM_SCRIPTS/create_incident.sh 'RMS_BACKOUT_ALERT' 'POISON_MESSAGES' '%%$ORDERID' 'high'"/>
            </ON>
        </JOB>

        <JOB
            JOBNAME="RMS_METRICS_COLLECT"
            DESCRIPTION="Collect RMS metrics for trending"
            NODEID="%%NODEID"
            CMDLINE="%%CTM_SCRIPTS/metrics_collect.sh rms %%SERVER_PORT_RMS %%CTM_LOG_DIR/rms_metrics.csv"
            TASKTYPE="Job"
            RUN_AS="%%RUN_AS"
            CYCLIC="Y"
            INTERVAL="01:00"
            MAXRERUN="0">
        </JOB>

        <!-- ================================================================ -->
        <!-- MAINTENANCE JOBS                                                  -->
        <!-- ================================================================ -->

        <JOB
            JOBNAME="RMS_LOG_CLEANUP"
            DESCRIPTION="Clean up RMS log files older than retention period"
            NODEID="%%NODEID"
            CMDLINE="%%CTM_SCRIPTS/log_cleanup.sh %%APP_BASE_RMS %%LOG_RETENTION_DAYS"
            TASKTYPE="Job"
            RUN_AS="%%RUN_AS"
            MAXRERUN="0"
            TIMEFROM="0200"
            TIMETO="0400">

            <SCHEDTABLE NAME="DAILY"/>
        </JOB>

        <JOB
            JOBNAME="RMS_TMP_CLEANUP"
            DESCRIPTION="Check for stale HDFS temp files"
            NODEID="%%NODEID"
            CMDLINE="%%CTM_SCRIPTS/tmp_cleanup.sh %%HDFS_BASE_RMS %%TMP_MAX_AGE_HOURS"
            TASKTYPE="Job"
            RUN_AS="%%RUN_AS"
            MAXRERUN="0"
            TIMEFROM="0300"
            TIMETO="0500">

            <SCHEDTABLE NAME="DAILY"/>

            <ON STMT="*" CODE="NOTOK">
                <DOSHOUT
                    DEST="%%EMAIL_OPS"
                    MESSAGE="Stale HDFS temp files found for RMS - review required"
                    URGENCY="R"/>
            </ON>
        </JOB>

    </FOLDER>
</DEFTABLE>
